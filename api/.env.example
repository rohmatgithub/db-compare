# Loaded by the API at startup from its working directory (override the path
# with ENV_FILE). Variables already set in the environment take precedence.

# Application database (PostgreSQL) for connections, projects, and results.
APP_DATABASE_URL=postgres://dbcompare:dbcompare@localhost:5432/dbcompare?sslmode=disable

# 32 random bytes, base64 encoded: openssl rand -base64 32
# Stored database passwords are encrypted with this key; keep it stable.
APP_SECRET_KEY=

LISTEN_ADDR=:8080

# First admin account, created only while the users table is empty. With an
# empty ADMIN_PASSWORD a random password is generated and written to the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# How long a sign-in stays valid.
SESSION_TTL=12h

RETENTION_DAYS=30
MAX_PARALLEL_TABLES=8
MAX_CONNS_PER_DB=10
QUERY_TIMEOUT=30m
HEARTBEAT_INTERVAL=10s
